@model pizza.Models.Pizza
@{
    ViewData["Title"] = "Pizza Menu";
}
<h1>Add New Pizza</h1>
<form asp-action="Create" method="post" class="form-card">
        <label asp-for="Name" class="form-label">Pizza Name: </label>
        <input asp-for="Name"  />
        <br />
        <label asp-for="Price" class="form-label">Price: </label>
        <input asp-for="Price" type="number"  />
        <br />
        <label asp-for="Category" class="form-label">Category: </label>
        <input asp-for="Category"  />
        <br />
        <button type="submit" class="button">Create Pizza</button>
        <a asp-action="Index" class="btn-secondary">Back</a>

</form>
