@model pizza.Models.Pizza
@{
    ViewData["Title"] = "Pizza Details";
}
<h1>Pizza Details</h1>
<div>

    <h2>Name: @Model.Name</h2>
    <p>
        <strong>Price:</strong>
        ₦@Model.Price.ToString("N0")
    </p>
    <p>
        <strong>Category:</strong>
        @Model.Category
    </p>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-warning">Edit</a><br />
    <a asp-action="Index" class="btn-secondary">Cancel</a>
</div>
