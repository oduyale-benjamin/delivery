@model pizza.Models.Pizza
@{
    ViewData["Title"] = "Pizza Details";
}
<h1>Pizza Details</h1>
<div>
    <h2>@Model.Name</h2>
    <p>
        <strong>Price:</strong>
        #@Model.Price.ToString("N0")
    </p>
    <p>
        <strong>Category:</strong>
        @Model.Category
    </p>
    <a asp-acion="Edit" asp-route-id="@Model.Id" class="btn-warning">Edit</a>
</div>