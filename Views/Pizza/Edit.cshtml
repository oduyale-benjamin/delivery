@model pizza.Models.Pizza
@{
    ViewData["Title"] = "Edit Pizza";
}
<h1>Edit Pizza</h1>
<form asp-action="Edit" method="post">
        <label asp-for="Name" class="form-label">Pizza Name</label>
        <input asp-for="Name" class="form-control" />
        <br />
        <label asp-for="Price" class="form-label">Price</label>
        <input asp-for="Price" type="number" class="form-label" />
        <br />
        <label asp-for="Category" class="form-label">Category</label>
        <input asp-for="Category" class="form-label" />
        <br />
        <button type="submit" class="btn-success">Create Pizza</button>
        <a asp-action="Index" class="btn-secondary">Cancel</a>
</form>