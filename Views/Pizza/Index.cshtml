@* @model IEnumerable<pizza.Models.Pizza> *@

@{
 ViewData["Title"] = "Pizza Menu";

<div class="card-grid">
        @foreach (var pizza in Model){
            <div class="pizza-card">
                <div class="card-grid" style="align-text:center;">
                <p>@pizza.Name</p>
                <p>₦@pizza.Price.ToString("N0")</p>
                <p>@pizza.Category</p>
                </div >
                <div style="align-item:center;">
                    <a asp-action="Detail" asp-route-id="@pizza.Id" class="btn-detail">Details</a>
                    <a asp-action="Edit" asp-route-id="@pizza.Id" class="btn-edit">Edit</a>
                    <a asp-action="Delete" asp-route-id="@pizza.Id" calss="btn-delete">Delete</a>
                </div>
                </div>
                    <br>
                    }
                </div>
                <br />
                <a asp-action="Create"style="color:white" ><button class="button" style="color:white;left:50px;position:relative">+ADD PIZZA</button></a>
                

}
